{
  "rule_version": "portfolio-preference-v0.2",
  "max_default_groups_per_scope": 5,
  "hypotheses": {
    "risk_tilt": [
      "conservative",
      "balanced",
      "growth"
    ],
    "adjustment_style": [
      "gradual",
      "flexible"
    ]
  },
  "priors": {
    "risk_tilt": [
      0.3333333333333333,
      0.3333333333333333,
      0.3333333333333333
    ],
    "adjustment_style": [
      0.5,
      0.5
    ]
  },
  "note": "Prototype support multipliers. Not calibrated to client data. Correlated events must share an evidence group.",
  "evidence_selection": "Strongest per group/scope/dimension; latest for ties in the same direction, neutral for opposing ties. Latest current statement per scope/dimension.",
  "rules": {
    "default_lower_equity": {
      "dimension": "risk_tilt",
      "multipliers": [
        1.05,
        1,
        0.95
      ],
      "condition": "Default equity target below reliable current equity."
    },
    "manual_lower_equity": {
      "dimension": "risk_tilt",
      "multipliers": [
        1.2,
        1,
        0.8
      ],
      "condition": "Manually requested equity target below reliable current equity."
    },
    "default_raise_equity": {
      "dimension": "risk_tilt",
      "multipliers": [
        0.95,
        1,
        1.05
      ],
      "condition": "Default equity target above reliable current equity."
    },
    "manual_raise_equity": {
      "dimension": "risk_tilt",
      "multipliers": [
        0.8,
        1,
        1.2
      ],
      "condition": "Manually requested equity target above reliable current equity."
    },
    "explicit_conservative": {
      "dimension": "risk_tilt",
      "multipliers": [
        8,
        1,
        0.5
      ],
      "condition": "Applicable affirmative advisor statement."
    },
    "explicit_balanced": {
      "dimension": "risk_tilt",
      "multipliers": [
        1,
        8,
        1
      ],
      "condition": "Applicable affirmative advisor statement."
    },
    "explicit_growth": {
      "dimension": "risk_tilt",
      "multipliers": [
        0.5,
        1,
        8
      ],
      "condition": "Applicable affirmative advisor statement."
    },
    "attention_only": {
      "dimension": "risk_tilt",
      "multipliers": [
        1,
        1,
        1
      ],
      "condition": "Observation without applicable preference direction."
    },
    "explicit_gradual": {
      "dimension": "adjustment_style",
      "multipliers": [
        8,
        1
      ],
      "condition": "Explicit preference for staged adjustments."
    },
    "explicit_flexible": {
      "dimension": "adjustment_style",
      "multipliers": [
        1,
        8
      ],
      "condition": "Explicit willingness to make a larger adjustment at once."
    },
    "choice_gradual": {
      "dimension": "adjustment_style",
      "multipliers": [
        3,
        1
      ],
      "condition": "Reasoned choice; current analysis only."
    },
    "choice_flexible": {
      "dimension": "adjustment_style",
      "multipliers": [
        1,
        3
      ],
      "condition": "Reasoned choice; current analysis only."
    },
    "hint_conservative": {
      "dimension": "risk_tilt",
      "multipliers": [
        1.15,
        1.0,
        1.0
      ],
      "condition": "Quoted directional client behaviour; tentative evidence only."
    },
    "hint_balanced": {
      "dimension": "risk_tilt",
      "multipliers": [
        1.0,
        1.15,
        1.0
      ],
      "condition": "Quoted directional client behaviour; tentative evidence only."
    },
    "hint_growth": {
      "dimension": "risk_tilt",
      "multipliers": [
        1.0,
        1.0,
        1.15
      ],
      "condition": "Quoted directional client behaviour; tentative evidence only."
    },
    "hint_gradual": {
      "dimension": "adjustment_style",
      "multipliers": [
        1.15,
        1.0
      ],
      "condition": "Quoted directional client behaviour; tentative evidence only."
    },
    "hint_flexible": {
      "dimension": "adjustment_style",
      "multipliers": [
        1.0,
        1.15
      ],
      "condition": "Quoted directional client behaviour; tentative evidence only."
    }
  }
}
